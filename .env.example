# Sanity — copy to .env.local and fill in values. Never commit real tokens.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_READ_TOKEN=
# Editor/Admin token — local scripts only (e.g. seed-technologies.mjs). Never expose in the browser.
SANITY_API_WRITE_TOKEN=
# Deploy token — for `npm run sanity:deploy:hosted` only. Create at sanity.io/manage → API → Tokens → Deploy Studio.
SANITY_AUTH_TOKEN=

# Supabase — server-only for form inserts
NEXT_PUBLIC_SUPABASE_URL=
# Optional alias (also accepted by createSupabaseAdmin):
# SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron auth for /api/cron/supabase-keepalive (generate a unique secret; do not reuse UniDocs)
CRON_SECRET=
WORDPRESS_FALLBACK_ORIGIN=https://uniware.net
# ── uniware.net cutover ──
# WordPress fallback: proxy unbuilt URLs to the old site.
# Pre-cutover testing on global.uniware.net: https://uniware.net
# After DNS go-live: swap to direct AWS IP/hostname from Dhana (NOT uniware.net).
WORDPRESS_FALLBACK_ORIGIN=

# GA4 — public measurement ID (G-XXXXXXXXXX). Site pages only, not Studio.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# SMTP — Uniware notification mailbox (server-only; never expose to browser)
SMTP_HOST=mail.uniwaresystems.com
SMTP_PORT=465
SMTP_USER=notification@uniwaresystems.com
SMTP_PASSWORD=
SMTP_FROM=Uniware Website <notification@uniwaresystems.com>
SMTP_SECURE=true
